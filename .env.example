# Environment Variables — Wedding Invitation
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# ─── Firebase ────────────────────────────────────────────────
# Set to 'true' to enable Firebase (RSVP, Gallery, Wishlist)
# Leave as 'false' to use mock localStorage data
VITE_FIREBASE_ENABLED='true'

# Firebase project configuration (from Firebase console > Project Settings)
VITE_FIREBASE_API_KEY="AIzaSyAQFvbrwQ3TiCbVdUGtgyEJ-KZFZ_oTt8I"
VITE_FIREBASE_AUTH_DOMAIN="wedding-invitation-2026-ebd1e.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="wedding-invitation-2026-ebd1e"
VITE_FIREBASE_STORAGE_BUCKET="wedding-invitation-2026-ebd1e.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID= "348409086401"
VITE_FIREBASE_APP_ID="1:348409086401:web:6ec26113ef940e1c7caf40"

# ─── Analytics ───────────────────────────────────────────────
# Optional Google Analytics 4 Measurement ID
VITE_ANALYTICS_ENABLED='true'
VITE_GA_MEASUREMENT_ID="G-8WSRX9S6TJ"

# ─── Build ───────────────────────────────────────────────────
# Set to 'true' when building for GitHub Pages
GITHUB_PAGES=false

